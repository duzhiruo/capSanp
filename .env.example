ADDR=:8080
DATABASE_DSN=root:password@tcp(127.0.0.1:3306)/capsnap?parseTime=true&multiStatements=true
UPLOAD_DIR=data/uploads
AUTO_MIGRATE=true

# DeepSeek 示例
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_PROVIDER=deepseek
LLM_TIMEOUT_SECONDS=30
LLM_INPUT_COST_PER_1M=0
LLM_OUTPUT_COST_PER_1M=0

OCR_BINARY_PATH=.cache/bin/ocr_vision
OCR_SCRIPT_PATH=tools/ocr_vision.swift
OCR_TIMEOUT_SECONDS=30

# Embedding（复用 LLM_API_KEY / LLM_BASE_URL）
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024

# Qdrant 向量库
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=screenshots
QDRANT_ENABLED=true

